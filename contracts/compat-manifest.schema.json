{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hoh:compat-manifest:1.0",
  "title": "Product compatibility manifest written by probe() (REQ-027, CR-003). One current entry per agent; a version is usable for a new attempt only while its implementation, help and schema hashes match the entry and suite.status=PASS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "agents"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "codex": {
          "$ref": "#/$defs/agent_entry"
        },
        "claude": {
          "$ref": "#/$defs/agent_entry"
        },
        "pi": {
          "$ref": "#/$defs/agent_entry"
        }
      }
    }
  },
  "$defs": {
    "agent_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cli_version",
        "launcher_path",
        "launcher_sha256",
        "implementation_path",
        "implementation_sha256",
        "transport",
        "help_sha256",
        "schema_sha256",
        "capabilities",
        "suite"
      ],
      "properties": {
        "cli_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "First line of `<cli> --version`, verbatim."
        },
        "launcher_path": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute path the adapter executes (first match on PATH)."
        },
        "launcher_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "implementation_path": {
          "type": "string",
          "minLength": 1,
          "description": "Resolved real implementation (pi install/releases/<version> entry, codex vendored native binary); equals launcher_path when the launcher is the implementation."
        },
        "implementation_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "transport": {
          "enum": [
            "app-server",
            "exec",
            "stream-json",
            "rpc"
          ],
          "description": "Selected native transport; codex falls back to exec when app-server is unavailable (AC-027-01)."
        },
        "help_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "sha256 of the concatenated relevant --help outputs."
        },
        "schema_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$",
          "description": "Native protocol schema hash; null when the CLI has no schema command."
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "description": "Probed capabilities (structured_events, resume, mid_turn_steer, partial_messages, ...); null means unknown."
        },
        "suite": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "fixture_set_sha256"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "NOT_RUN"
              ]
            },
            "fixture_set_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "run_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "cases": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "case",
                  "status"
                ],
                "properties": {
                  "case": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "PASS",
                      "FAIL",
                      "NOT_RUN"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

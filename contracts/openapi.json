{
  "openapi": "3.1.0",
  "info": {
    "title": "HoH Local Control API",
    "version": "1.1.0",
    "description": "Design contract. The server is not implemented in this bootstrap pack. Local-only: the host binds 127.0.0.1, rejects requests whose Host or Origin is not the bound loopback address (DNS-rebinding/CSRF guard), and requires a per-host random token. This is request integrity for a single-user VM, not a multi-tenant permission system."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "paths": {
    "/v1/commands": {
      "post": {
        "operationId": "submitCommand",
        "summary": "持久接收命令；202不是任务完成",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./protocol.schema.json#/$defs/Command"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durably accepted (not task completion). A replay with the same idempotency_key and the same payload hash returns the original 202 body byte for byte and sets Idempotent-Replayed: true; the same key with a different payload is 409 KEY_REUSE (CR-003).",
            "headers": {
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Present only on a replay."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "command_id",
                    "run_id",
                    "revision",
                    "status"
                  ],
                  "properties": {
                    "command_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "run_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 160,
                      "description": "Run the command applies to; for StartRun the run created in the same transaction."
                    },
                    "revision": {
                      "type": "integer"
                    },
                    "status": {
                      "const": "ACCEPTED"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v1/runs/{run_id}": {
      "get": {
        "operationId": "getRun",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        ],
        "responses": {
          "200": {
            "description": "权威snapshot与watermark",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "run_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "state": {
                      "type": "string"
                    },
                    "revision": {
                      "type": "integer"
                    },
                    "watermark": {
                      "type": "integer"
                    },
                    "projection": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "run_id",
                    "state",
                    "revision",
                    "watermark",
                    "projection"
                  ]
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "streamEvents",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "run_id",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          {
            "name": "kinds",
            "in": "query",
            "description": "Comma-separated event kinds",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Replay then live. Each SSE id is event seq.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "410": {
            "description": "Cursor outside retention; load the snapshot then resume after snapshot_watermark",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message",
                    "snapshot_watermark"
                  ],
                  "properties": {
                    "code": {
                      "const": "CURSOR_EXPIRED"
                    },
                    "message": {
                      "type": "string"
                    },
                    "snapshot_watermark": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "description": "SSE: replay (after, H] then live > H where H is the high-watermark taken at connect. after and Last-Event-ID must agree (409 otherwise)."
      }
    },
    "/v1/artifacts/{artifact_id}": {
      "get": {
        "operationId": "getArtifact",
        "parameters": [
          {
            "name": "artifact_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        ],
        "responses": {
          "200": {
            "description": "基于注册ID读取对象；不是任意文件路径",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "responses": {
          "200": {
            "description": "当前Host/Agent协议能力，不含凭证",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Liveness；不代表模型可用"
          },
          "503": {
            "description": "Host unavailable"
          }
        },
        "security": []
      }
    },
    "/v1/runs": {
      "get": {
        "operationId": "listRuns",
        "summary": "Runs of this project, newest first",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Runs of this project, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/runs/{run_id}/tasks": {
      "get": {
        "operationId": "listTasks",
        "summary": "Tasks with state, dependencies and lease holder",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/RunId"
          }
        ],
        "responses": {
          "200": {
            "description": "Tasks with state, dependencies and lease holder",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/runs/{run_id}/acceptance": {
      "get": {
        "operationId": "listAcceptance",
        "summary": "Acceptance projection per (spec revision, candidate, AC)",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/RunId"
          }
        ],
        "responses": {
          "200": {
            "description": "Acceptance projection per (spec revision, candidate, AC)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/runs/{run_id}/issues": {
      "get": {
        "operationId": "listIssues",
        "summary": "Issues with severity/state",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/RunId"
          }
        ],
        "responses": {
          "200": {
            "description": "Issues with severity/state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/runs/{run_id}/evidence": {
      "get": {
        "operationId": "listEvidence",
        "summary": "Evidence records bound to candidates",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/RunId"
          }
        ],
        "responses": {
          "200": {
            "description": "Evidence records bound to candidates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/runs/{run_id}/team": {
      "get": {
        "operationId": "listTeam",
        "summary": "Role bindings with role_epoch, agent, model (no secrets)",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/RunId"
          }
        ],
        "responses": {
          "200": {
            "description": "Role bindings with role_epoch, agent, model (no secrets)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/runs/{run_id}/timeline": {
      "get": {
        "operationId": "listTimeline",
        "summary": "Timeline blocks (project/iteration/agent level)",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/RunId"
          },
          {
            "name": "level",
            "in": "query",
            "schema": {
              "enum": [
                "project",
                "iteration",
                "agent"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Timeline blocks (project/iteration/agent level)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/specs": {
      "get": {
        "operationId": "listSpecs",
        "summary": "Spec revisions and change requests (Git files remain authoritative)",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "Spec revisions and change requests (Git files remain authoritative)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Error": {
        "description": "机器code与可读诊断",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Missing/invalid token, or Host/Origin not the bound loopback address",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "localToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-HoH-Token",
        "description": "Random 256-bit token generated at host start, stored in .hoh/host.json (mode 0600). `hoh web` opens the browser with the token in the URL fragment; the page keeps it in memory. SSE uses the same header via fetch-based EventSource."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "anyOf": [
              {
                "$ref": "./protocol.schema.json#/$defs/ReasonCode"
              },
              {
                "type": "string",
                "pattern": "^(FORBIDDEN|BAD_REQUEST|NOT_FOUND|CONFLICT|GONE|UNPROCESSABLE)$"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "current_revision": {
            "type": [
              "integer",
              "null"
            ]
          },
          "details": {
            "type": "object",
            "description": "Machine-readable context, e.g. key_path, cycle, required/available (CR-003)."
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "current_revision"
        ]
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "watermark"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "watermark": {
            "type": "integer",
            "minimum": 0,
            "description": "event seq the page is consistent with"
          }
        }
      }
    },
    "parameters": {
      "RunId": {
        "name": "run_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string"
        }
      }
    }
  },
  "security": [
    {
      "localToken": []
    }
  ]
}

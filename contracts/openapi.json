{
  "openapi": "3.1.0",
  "info": {
    "title": "HoH Local Control API",
    "version": "1.0.0",
    "description": "Design contract. The server is not implemented in this bootstrap pack."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "paths": {
    "/v1/commands": {
      "post": {
        "operationId": "submitCommand",
        "summary": "持久接收命令；202不是任务完成",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./protocol.schema.json#/$defs/Command"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "command_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "revision": {
                      "type": "integer"
                    },
                    "status": {
                      "const": "ACCEPTED"
                    }
                  },
                  "required": [
                    "command_id",
                    "revision",
                    "status"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/runs/{run_id}": {
      "get": {
        "operationId": "getRun",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        ],
        "responses": {
          "200": {
            "description": "权威snapshot与watermark",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "run_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "state": {
                      "type": "string"
                    },
                    "revision": {
                      "type": "integer"
                    },
                    "watermark": {
                      "type": "integer"
                    },
                    "projection": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "run_id",
                    "state",
                    "revision",
                    "watermark",
                    "projection"
                  ]
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "streamEvents",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Replay then live. Each SSE id is event seq.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "410": {
            "description": "Cursor过期；需重新加载snapshot"
          }
        }
      }
    },
    "/v1/artifacts/{artifact_id}": {
      "get": {
        "operationId": "getArtifact",
        "parameters": [
          {
            "name": "artifact_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        ],
        "responses": {
          "200": {
            "description": "基于注册ID读取对象；不是任意文件路径",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "responses": {
          "200": {
            "description": "当前Host/Agent协议能力，不含凭证",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Liveness；不代表模型可用"
          },
          "503": {
            "description": "Host unavailable"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Error": {
        "description": "机器code与可读诊断",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "message": {
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                },
                "current_revision": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "code",
                "message",
                "retryable",
                "current_revision"
              ]
            }
          }
        }
      }
    }
  }
}

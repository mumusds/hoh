{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hoh:independent-report:1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "role": {
      "enum": [
        "qa",
        "reviewer"
      ]
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "role",
    "session_id",
    "candidate_id",
    "spec_sha256",
    "status",
    "scope",
    "findings",
    "raw_session"
  ]
}

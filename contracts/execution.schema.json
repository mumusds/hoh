{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "record_type": {
      "const": "command_execution"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "check_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^CAND-[a-f0-9]{64}$"
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "enum": [
        "mock",
        "live",
        "product",
        "bundle"
      ]
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)",
      "description": "Working directory relative to the candidate checkout root; must equal the check plan entry."
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "exit_code": {
      "type": "integer"
    },
    "timed_out": {
      "type": "boolean"
    },
    "stdout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "stderr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "candidate_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "source_unchanged": {
      "type": "boolean"
    },
    "environment_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "test_plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifacts": {
      "type": "array",
      "description": "Declared check-plan artifacts found after the command exited.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "missing_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "producer_attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "Runtime attempt that produced this execution; the bootstrap tool uses its own record_id."
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "euid"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "euid": {
          "type": "integer"
        },
        "boot_id": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "check_id",
    "candidate_id",
    "spec_sha256",
    "mode",
    "command",
    "cwd",
    "started_at",
    "finished_at",
    "duration_seconds",
    "exit_code",
    "timed_out",
    "stdout",
    "stderr",
    "candidate_manifest",
    "source_unchanged",
    "environment_sha256",
    "test_plan_sha256",
    "artifacts",
    "missing_artifacts",
    "producer_attempt_id",
    "runner"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hoh:execution:1.1"
}

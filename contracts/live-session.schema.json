{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hoh:live-session:1.0",
  "title": "Native agent sessions actually used by a live-mode check. Written by the check itself under $HOH_EVIDENCE_DIR. Reviewers cross-check session ids with native session stores.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "check_id", "harness_candidate_id", "sessions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "check_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "harness_candidate_id": {"type": "string", "pattern": "^CAND-[a-f0-9]{64}$"},
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent", "cli_version", "session_id", "resolved_model"],
        "properties": {
          "agent": {"enum": ["codex", "claude", "pi"]},
          "cli_version": {"type": "string", "minLength": 1, "maxLength": 160},
          "session_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "resolved_model": {"type": "string", "minLength": 1, "maxLength": 200, "description": "Model reported by the native CLI, or 'unknown' if the CLI did not report it."},
          "plugins": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["package", "version"],
              "properties": {"package": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    }
  }
}

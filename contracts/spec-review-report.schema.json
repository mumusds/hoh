{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hoh:spec-review-report:1.0",
  "description": "Independent review of an approved specification revision, not of a candidate (REQ-031 behaviour 3, CR-026): bound to the revision's id, digest and specification commit; collected as spec_review.reported, never as an independent_reports row.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "role": {
      "const": "reviewer"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_revision": {
      "type": "integer",
      "minimum": 1
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "raw_session": {
      "$ref": "#/$defs/FileRef"
    },
    "native_attempt": {
      "$ref": "#/$defs/FileRef",
      "description": "The Runtime's export of the native attempt that produced this report (contracts/spec-review-attempt.schema.json). Its session_ids must contain session_id; its spec_revision, spec_sha256 and git_commit must be this report's; its stdout_sha256 must be raw_session's sha256."
    }
  },
  "required": [
    "schema_version",
    "role",
    "session_id",
    "spec_revision",
    "spec_sha256",
    "git_commit",
    "status",
    "scope",
    "findings",
    "raw_session",
    "native_attempt"
  ],
  "$defs": {
    "FileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileRef"
          }
        }
      }
    }
  }
}

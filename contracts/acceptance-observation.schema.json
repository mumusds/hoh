{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hoh:acceptance-observation:1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "ac_id": {
      "type": "string",
      "pattern": "^AC-[0-9]{3}$"
    },
    "test_id": {
      "type": "string",
      "pattern": "^TEST-[0-9]{3}$"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "check_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observed": {
      "type": "string",
      "minLength": 16
    },
    "raw_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "ac_id",
    "test_id",
    "candidate_id",
    "spec_sha256",
    "status",
    "check_ids",
    "observed",
    "raw_evidence"
  ]
}

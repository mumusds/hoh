{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hoh:acceptance-observation:1.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "ac_id": {
      "type": "string",
      "pattern": "^AC-[0-9]{3}-[0-9]{2}$"
    },
    "test_id": {
      "type": "string",
      "pattern": "^TEST-[0-9]{3}-[0-9]{2}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^CAND-[a-f0-9]{64}$"
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "PASS",
        "DEGRADED",
        "FAIL",
        "BLOCKED",
        "FLAKY",
        "INVALID",
        "UNKNOWN",
        "NOT_RUN"
      ]
    },
    "check_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observed": {
      "type": "string",
      "minLength": 16
    },
    "raw_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "degradation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "upstream_ref",
        "diagnostic"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 16
        },
        "upstream_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Upstream issue/version/commit showing the third-party limitation."
        },
        "diagnostic": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "ac_id",
    "test_id",
    "candidate_id",
    "spec_sha256",
    "status",
    "check_ids",
    "observed",
    "raw_evidence"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "DEGRADED"
          }
        }
      },
      "then": {
        "required": [
          "degradation"
        ]
      },
      "else": {
        "not": {
          "required": [
            "degradation"
          ]
        }
      }
    }
  ]
}

{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "baseline_id": {
      "type": "string",
      "pattern": "^HOH-BASELINE-[0-9]+\\.[0-9]+$"
    },
    "requirements_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^CAND-[a-f0-9]{64}$"
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "developer_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "status": {
            "enum": [
              "PASS",
              "DEGRADED",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "SKIPPED",
              "INVALID",
              "UNKNOWN",
              "FLAKY"
            ]
          },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "degradation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "upstream_ref",
              "diagnostic"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 16
              },
              "upstream_ref": {
                "type": "string",
                "minLength": 1
              },
              "diagnostic": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "id",
          "status",
          "execution"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "DEGRADED"
                }
              }
            },
            "then": {
              "required": [
                "degradation"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "degradation"
                ]
              }
            }
          }
        ]
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]{3}-[0-9]{2}$"
          },
          "status": {
            "enum": [
              "PASS",
              "DEGRADED",
              "FAIL",
              "BLOCKED",
              "FLAKY",
              "NOT_RUN",
              "INVALID",
              "UNKNOWN"
            ]
          },
          "check_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "observation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "required": [
          "id",
          "status",
          "check_ids",
          "observation"
        ]
      }
    },
    "independent_reports": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "qa",
              "reviewer"
            ]
          },
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "candidate_id": {
            "type": "string",
            "pattern": "^CAND-[a-f0-9]{64}$"
          },
          "spec_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "required": [
          "role",
          "session_id",
          "candidate_id",
          "spec_sha256",
          "status",
          "artifact"
        ]
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "severity",
          "description"
        ]
      }
    },
    "soak": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_check_id": {
          "const": "soak"
        },
        "live_iterations": {
          "type": "integer",
          "minimum": 0
        },
        "timeline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      },
      "required": [
        "execution_check_id",
        "live_iterations",
        "timeline"
      ]
    },
    "release_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "candidate_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9.]+$",
      "description": "Release profile from release-policy.json profiles."
    }
  },
  "required": [
    "schema_version",
    "baseline_id",
    "requirements_sha256",
    "candidate_id",
    "spec_sha256",
    "developer_session_id",
    "checks",
    "acceptance",
    "independent_reports",
    "open_issues",
    "release_artifact",
    "candidate_manifest",
    "profile"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hoh:release:1.1"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hoh:check-plan:1.0",
  "title": "Machine-readable test plan frozen into a candidate. run_check executes only the argv declared here; the release gate compares every execution record with it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "checks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "description": {"type": "string"},
    "checks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "argv"],
        "properties": {
          "mode": {"enum": ["bundle", "mock", "product", "live"]},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "minLength": 1, "pattern": "^(?!/)", "default": "."},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
          "artifacts": {
            "description": "Files the command must write under $HOH_EVIDENCE_DIR; run_check hashes them after the command exits.",
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
          },
          "description": {"type": "string"}
        }
      }
    }
  }
}

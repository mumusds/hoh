{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hoh:protocol:1.0",
  "title": "HoH Collaboration Protocol (HCP), not ACP",
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "git_commit": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "git_tree": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "spec_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "environment_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "test_plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "git_commit",
        "git_tree",
        "spec_sha256",
        "environment_sha256",
        "test_plan_sha256"
      ]
    },
    "ContextHandoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "role_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "spec_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Candidate"
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptance_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        },
        "output_contract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "budget_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "handoff_kind": {
          "enum": [
            "verification",
            "role_change",
            "task"
          ]
        },
        "spec_revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "description": "Checkpoint package for a role change (REQ-019 B[3]); ids reference rows, never transcripts.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applied_decision_ids",
            "open_issue_ids",
            "unacked_message_ids",
            "queued_input_ids"
          ],
          "properties": {
            "applied_decision_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "open_issue_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "unacked_message_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "queued_input_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "task_id",
        "goal",
        "role",
        "role_epoch",
        "spec_sha256",
        "candidate",
        "acceptance_ids",
        "references",
        "output_contract",
        "budget_tokens",
        "handoff_kind",
        "spec_revision"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "handoff_kind": {
                "const": "verification"
              }
            }
          },
          "then": {
            "properties": {
              "candidate": {
                "$ref": "#/$defs/Candidate"
              },
              "task_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "acceptance_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "handoff_kind": {
                "const": "task"
              }
            }
          },
          "then": {
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "handoff_kind": {
                "const": "role_change"
              }
            }
          },
          "then": {
            "required": [
              "state"
            ]
          }
        }
      ]
    },
    "Message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sender_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "recipient_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "role_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "causation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "spec_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "dispatch",
            "query",
            "handoff",
            "result",
            "decision",
            "steer",
            "cancel",
            "ack",
            "rejected"
          ]
        },
        "payload": {
          "type": "object"
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/RejectionReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "message_id",
        "run_id",
        "task_id",
        "attempt_id",
        "sender_role",
        "recipient_role",
        "role_epoch",
        "correlation_id",
        "causation_id",
        "idempotency_key",
        "expected_revision",
        "spec_sha256",
        "candidate_id",
        "kind",
        "payload"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "rejected"
              }
            }
          },
          "then": {
            "required": [
              "reason_code"
            ],
            "properties": {
              "reason_code": {
                "$ref": "#/$defs/RejectionReason"
              }
            }
          }
        }
      ]
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        },
        "attempt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "seq",
        "event_id",
        "run_id",
        "attempt_id",
        "at",
        "kind",
        "payload"
      ]
    },
    "Command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "StartRun",
            "SetMode",
            "SendInput",
            "ConfigureTeam",
            "ProposeSpecChange",
            "PauseRun",
            "ResumeRun",
            "CancelRun",
            "ApproveSpec",
            "AnswerQuestion"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "command_id",
        "idempotency_key",
        "expected_revision",
        "kind",
        "run_id",
        "payload"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "StartRun"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "goal": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mode": {
                    "enum": [
                      "PLAN",
                      "BUILD",
                      "AUTO"
                    ]
                  },
                  "interactive": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "goal",
                  "mode",
                  "interactive"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "SetMode"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "enum": [
                      "PLAN",
                      "BUILD",
                      "AUTO"
                    ]
                  }
                },
                "required": [
                  "mode"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "SendInput"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target_role": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "input_kind": {
                    "enum": [
                      "ASK",
                      "STEER",
                      "CHANGE",
                      "CONTROL",
                      "REPLY"
                    ]
                  }
                },
                "required": [
                  "text",
                  "target_role",
                  "input_kind"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ConfigureTeam"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "bindings": {
                    "type": "object",
                    "minProperties": 1
                  },
                  "apply_at": {
                    "const": "checkpoint"
                  }
                },
                "required": [
                  "bindings",
                  "apply_at"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ProposeSpecChange"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "spec_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "reason",
                  "spec_sha256"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "PauseRun"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "reason"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ResumeRun"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "reason"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "CancelRun"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "reason"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ApproveSpec"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "spec_sha256",
                  "decision"
                ],
                "properties": {
                  "spec_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "decision": {
                    "enum": [
                      "APPROVE_AND_BUILD",
                      "APPROVE_ONLY",
                      "REJECT"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "AnswerQuestion"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "question_id",
                  "answer"
                ],
                "properties": {
                  "question_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "answer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "choice_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "TaskResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "role_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "COMPLETED",
            "FAILED",
            "BLOCKED",
            "INCOMPLETE"
          ]
        },
        "summary": {
          "type": "string"
        },
        "candidate_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "next_action": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "task_id",
        "attempt_id",
        "role",
        "role_epoch",
        "status",
        "summary",
        "candidate_id",
        "evidence",
        "issues",
        "next_action"
      ]
    },
    "BlockedReason": {
      "description": "runs/tasks/role_bindings.blocked_reason (CR-003). Precedence for runs: BLOCKED_AUTH > COMMANDER_UNAVAILABLE > BUDGET_UNENFORCEABLE > BLOCKED_CAPABILITY > NEED_DECISION.",
      "enum": [
        "NEED_DECISION",
        "BLOCKED_AUTH",
        "BLOCKED_CAPABILITY",
        "COMMANDER_UNAVAILABLE",
        "BUDGET_UNENFORCEABLE",
        "AGENT_UNAVAILABLE",
        "MODEL_UNAVAILABLE",
        "COMPAT_UNVERIFIED"
      ]
    },
    "RejectionReason": {
      "description": "decisions.reason_code and Message kind=rejected payload.reason_code (CR-003).",
      "enum": [
        "STALE_ROLE_EPOCH",
        "STALE_REVISION",
        "STALE_LEASE_EPOCH",
        "SPEC_MISMATCH",
        "CANDIDATE_MISMATCH",
        "ILLEGAL_TRANSITION",
        "DEPENDENCY_NOT_ACCEPTED",
        "BUDGET_NOT_RESERVABLE",
        "ROLE_CAPABILITY_MISSING",
        "EVIDENCE_GATE_UNMET",
        "SESSION_NOT_INDEPENDENT",
        "KEY_REUSE"
      ]
    },
    "ErrorCode": {
      "description": "API Error.code / CLI stderr code / attempt failure_reason (CR-003).",
      "enum": [
        "CAPABILITY_UNSUPPORTED",
        "RUN_NOT_FOUND",
        "DB_BUSY",
        "DB_ON_NETWORK_FS",
        "DB_WAL_UNSUPPORTED",
        "INVALID_TEAM_CONFIG",
        "CONTEXT_BUDGET_TOO_SMALL",
        "PROTOCOL_FRAME_TOO_LARGE",
        "PROTOCOL_INCOMPLETE",
        "DAG_CYCLE",
        "DAG_MISSING_DEPENDENCY",
        "SCORE_OUT_OF_RANGE",
        "CURSOR_EXPIRED"
      ]
    },
    "ReasonCode": {
      "description": "Every reason code HoH emits. New codes need a CR (CR-003).",
      "anyOf": [
        {
          "$ref": "#/$defs/BlockedReason"
        },
        {
          "$ref": "#/$defs/RejectionReason"
        },
        {
          "$ref": "#/$defs/ErrorCode"
        }
      ]
    },
    "DecisionPayload": {
      "description": "Commander proposal body, validated by the Runtime before any state change (REQ-035, CR-003).",
      "type": "object",
      "required": [
        "kind"
      ],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": [
            "kind",
            "task_id",
            "role"
          ],
          "properties": {
            "kind": {
              "const": "dispatch"
            },
            "task_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "role": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "kind",
            "task_id",
            "to_state"
          ],
          "properties": {
            "kind": {
              "const": "transition_task"
            },
            "task_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "to_state": {
              "enum": [
                "PENDING",
                "READY",
                "LEASED",
                "RUNNING",
                "IMPLEMENTED",
                "VERIFYING",
                "ACCEPTED",
                "BLOCKED",
                "CANCELLED"
              ]
            },
            "reason": {
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "kind",
            "to_state"
          ],
          "properties": {
            "kind": {
              "const": "transition_run"
            },
            "to_state": {
              "enum": [
                "CREATED",
                "DISCOVERING",
                "SPECIFYING",
                "READY",
                "RUNNING",
                "VERIFYING",
                "PAUSE_REQUESTED",
                "PAUSED",
                "WAITING_EXTERNAL",
                "BLOCKED",
                "CANCEL_REQUESTED",
                "CANCELLED",
                "INCOMPLETE",
                "FAILED",
                "COMPLETED"
              ]
            },
            "accepted_requirements": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "reason": {
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "kind",
            "question_id",
            "question",
            "requires_user"
          ],
          "properties": {
            "kind": {
              "const": "request_user_decision"
            },
            "question_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "choices": {

{
  "schema_version": "1.1",
  "baseline_id": "HOH-BASELINE-1.1",
  "checks": {
    "build": {
      "mode": "product"
    },
    "static": {
      "mode": "product"
    },
    "unit": {
      "mode": "product"
    },
    "integration": {
      "mode": "product"
    },
    "adapter-live": {
      "mode": "live"
    },
    "tui-pty": {
      "mode": "product"
    },
    "web-e2e": {
      "mode": "product"
    },
    "plugin-live": {
      "mode": "live",
      "degradable": true,
      "requires_plugins": true
    },
    "recovery": {
      "mode": "product"
    },
    "deployment": {
      "mode": "product"
    },
    "soak": {
      "mode": "live"
    },
    "independent-qa": {
      "mode": "live"
    },
    "independent-review": {
      "mode": "live"
    },
    "traceability": {
      "mode": "product"
    }
  },
  "profiles": {
    "v1": {
      "description": "Complete v1 release: every requirement whose release_targets contains v1.",
      "release_status_on_pass": "COMPLETED",
      "release_status_on_degraded_pass": "COMPLETED_DEGRADED",
      "required_checks": [
        "build",
        "static",
        "unit",
        "integration",
        "adapter-live",
        "tui-pty",
        "web-e2e",
        "plugin-live",
        "recovery",
        "deployment",
        "soak",
        "independent-qa",
        "independent-review",
        "traceability"
      ],
      "requires_soak": true,
      "live_agents": {
        "adapter-live": [
          "claude",
          "codex",
          "pi"
        ],
        "plugin-live": [
          "pi"
        ]
      }
    },
    "v0.1": {
      "description": "Interim usable release: requirements whose release_targets contains v0.1 (CLI/TUI shell, Claude adapter, durable runtime, frozen candidate with independent QA/review). Never reported as COMPLETED.",
      "release_status_on_pass": "INTERIM_RELEASED",
      "release_status_on_degraded_pass": "INTERIM_RELEASED",
      "required_checks": [
        "build",
        "static",
        "unit",
        "integration",
        "adapter-live",
        "tui-pty",
        "recovery",
        "deployment",
        "independent-qa",
        "independent-review",
        "traceability"
      ],
      "requires_soak": false,
      "live_agents": {
        "adapter-live": [
          "claude"
        ]
      }
    }
  },
  "minimum_soak_seconds": 259200,
  "minimum_live_iterations": 20,
  "required_zero_issue_severities": [
    "critical",
    "high"
  ],
  "artifacts": {
    "live_sessions": "live-sessions.json",
    "soak_timeline": "timeline.jsonl",
    "test_results": "test-results.jsonl",
    "independent_report": "independent-report.json",
    "release_bundle": "hoh-release.tar.gz"
  },
  "accepted_attempt_statuses": [
    "NATIVE_TURN_COMPLETED",
    "COMPLETED"
  ],
  "degradation_rule": "Only checks marked degradable and acceptance criteria of requirements with release_class=degradable may be DEGRADED. A DEGRADED item still needs a bound execution record, a diagnostic artifact and an upstream reference; the release status then says DEGRADED.",
  "evidence_rule": "Every acceptance criterion needs per-test evidence: the test_results artifact of its scenario check lists its test_id at least once and every such line is PASS (DEGRADED for a degraded AC). live_agents lists the agents whose sessions a live check must contain; plugin-live sessions must name the plugins they loaded. The release artifact is the release_bundle produced by the build check (CR-003)."
}
